# Postgres (esquema growvibe). Mismo formato que usa la otra app del servidor.
DATABASE_URL=postgresql://postgres:CONTRASEÑA@HOST:5432/postgres?sslmode=disable

# Redis
REDIS_URL=redis://redis:6379

# Google (Places API (New) + Geocoding habilitadas, key restringida a esas APIs)
GOOGLE_MAPS_API_KEY=

# Claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL_GENERATE=claude-sonnet-5-5
CLAUDE_MODEL_CLASSIFY=claude-haiku-5-5

# Evolution API
EVOLUTION_API_URL=http://evolution-api:8080
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=growvibe
EVOLUTION_WEBHOOK_SECRET=

# Brevo
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=GrowVibe
BREVO_WEBHOOK_SECRET=

# App
APP_URL=http://localhost:3000
UNSUBSCRIBE_SECRET=
TZ=America/Mexico_City

# Solo docker-compose (Evolution API propia)
EVOLUTION_POSTGRES_PASSWORD=change-me
EVOLUTION_PUBLIC_URL=http://localhost:8080
